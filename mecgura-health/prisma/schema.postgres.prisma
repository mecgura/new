// GENERATED from prisma/schema.prisma by scripts/sync-pg-schema.mjs — do not edit.
// MECGURA HEALTH — database schema (Phase 0 foundation).
//
// Conventions (every future model MUST follow them):
//  * String cuid ids; strings instead of Prisma enums so SQLite (dev) and
//    PostgreSQL (prod) share one schema. Allowed values live in src/lib/*/constants.
//  * Every business record carries `tenantId` + an index starting with tenantId.
//    Register the model in src/lib/tenant/scoped-models.ts so server-side
//    tenant isolation is applied automatically.
//  * createdAt / updatedAt on everything; `deletedAt` for records that must be
//    recoverable (soft delete). AuditLog is append-only and never soft-deleted.
//  * PostgreSQL schema is GENERATED from this file: `npm run db:sync-schema`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A clinic / doctor practice. Root of all tenant data.
model Tenant {
  id                     String    @id @default(cuid())
  name                   String
  legalName              String?
  slug                   String    @unique
  /// INDIVIDUAL_DOCTOR | SINGLE_SPECIALIST | MULTI_DOCTOR | SPECIALIST_CLINIC | DIAGNOSTIC | OTHER
  clinicType             String    @default("MULTI_DOCTOR")
  /// Custom domain, e.g. "drsharma.com" (lowercase, no scheme). Only RESOLVES once verified.
  customDomain           String?   @unique
  /// Set manually by a Super Admin after DNS/SSL are confirmed. Null = not verified, not resolved.
  customDomainVerifiedAt DateTime?
  /// Subdomain label under TENANT_ROOT_DOMAIN
  subdomain              String?   @unique
  contactEmail           String?
  contactPhone           String?
  alternatePhone         String?
  address                String?
  city                   String?
  state                  String?
  country                String    @default("India")
  pincode                String?
  timezone               String    @default("Asia/Kolkata")
  /// Public website switch (the website itself is Phase 2)
  websiteEnabled         Boolean   @default(false)
  /// ACTIVE | TRIAL | SUSPENDED | INACTIVE
  status                 String    @default("TRIAL")
  /// true => seeded demo workspace; never holds real patient data
  isDemo                 Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  branding         TenantBranding?
  subscription     Subscription?
  users            User[]
  auditLogs        AuditLog[]
  assets           TenantAsset[]
  invitations      Invitation[]
  doctorProfiles   DoctorProfile[]
  staffProfiles    StaffProfile[]
  permissionGrants UserPermissionGrant[]

  @@index([status])
  @@index([clinicType])
}

/// White-label theme for one tenant (1:1). Null colour => product default.
model TenantBranding {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String? // #RRGGBB
  secondaryColor String? // #RRGGBB
  accentColor    String? // #RRGGBB
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Commercial plan. `modules` is a JSON array of module keys (src/config/modules.ts).
model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  modules       String         @default("[]")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// Which plan a tenant is on. One current subscription per tenant (Phase 0).
model Subscription {
  id        String    @id @default(cuid())
  tenantId  String    @unique
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id])
  /// TRIAL | ACTIVE | PAST_DUE | CANCELLED
  status    String    @default("TRIAL")
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([planId])
}

/// Role definition. tenantId = null => system role (SUPER_ADMIN, DOCTOR, ...).
/// Tenant-defined custom roles arrive later; Phase 0 only has system roles.
model Role {
  id          String           @id @default(cuid())
  tenantId    String?
  key         String
  name        String
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([key])
}

/// Permission catalogue, e.g. "patients.view". Source of truth: src/lib/permissions.
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Staff/platform account. tenantId = null only for SUPER_ADMIN.
model User {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  email            String    @unique
  name             String
  phone            String?   @unique
  avatarUrl        String?
  /// Null until an invited user sets their password
  passwordHash     String?
  /// ACTIVE | INVITED | SUSPENDED | DISABLED
  status           String    @default("ACTIVE")
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  auditLogs        AuditLog[]
  doctorProfile    DoctorProfile?
  staffProfile     StaffProfile?
  invitations      Invitation[]
  permissionGrants UserPermissionGrant[]

  @@index([tenantId, status])
  @@index([tenantId, roleId])
  @@index([roleId])
}

/// Append-only audit trail. NEVER store medical content or secrets in `metadata`
/// — only identifiers and non-sensitive context (see src/lib/audit).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  /// e.g. "patient.viewed" — see AUDIT_ACTIONS
  action     String
  entityType String?
  entityId   String?
  /// JSON string, redacted + size-capped
  metadata   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/// Doctor profile (1:1 with a DOCTOR user). Services, availability, public page etc. come later.
model DoctorProfile {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification      String?
  specialization     String?
  registrationNumber String?
  experienceYears    Int?
  /// MALE | FEMALE | OTHER | UNDISCLOSED
  gender             String?
  bio                String?
  /// Whole rupees; fee rules/billing are a later phase
  consultationFee    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

/// Staff profile (1:1 with any non-doctor staff user).
model StaffProfile {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeRef String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

/// Extra permission granted to ONE user on top of the role defaults (only grantable permissions).
model UserPermissionGrant {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([tenantId])
}

/// Invitation to set a password. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId])
}

/// Uploaded image bytes (logo, favicon, avatars). Phase 1 stores them in the database — validated
/// by magic bytes and size — until object storage is configured. LOGO/FAVICON are public.
model TenantAsset {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// LOGO | FAVICON | AVATAR
  kind      String
  /// userId for AVATAR, empty string otherwise
  ownerId   String   @default("")
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind, ownerId])
}
