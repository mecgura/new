{
  "name": "mecgura-health",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:sync-schema": "node scripts/sync-pg-schema.mjs",
    "db:check-schema": "node scripts/sync-pg-schema.mjs --check",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --omit=dev",
    "perf": "vitest run --config vitest.perf.config.ts",
    "backup": "node scripts/backup.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "env:check": "node scripts/check-env.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "qa:integrity": "node scripts/data-integrity.mjs",
    "backup:verify": "node scripts/restore-verify.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.41.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3"
  }
}
