# MECGURA HEALTH — environment configuration.
# Copy to .env (development) — NEVER commit real values.
# Staging/production: set these in the hosting provider's secret store.

# --- Runtime -----------------------------------------------------------------
# development | production  (NODE_ENV is set by Next.js; APP_ENV adds "staging")
APP_ENV="development"

# --- Database ----------------------------------------------------------------
# Development: SQLite file (schema: prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Staging/production: PostgreSQL (schema: prisma/schema.postgres.prisma)
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"
# DATABASE_URL="postgresql://user:password@host:5432/mecgura_health?sslmode=require"

# --- Auth --------------------------------------------------------------------
# Required. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (used for same-origin checks and absolute URLs)
APP_URL="http://localhost:3000"

# --- White-label / tenancy ---------------------------------------------------
# Root domain for tenant subdomains, e.g. "health.example.com" => clinic.health.example.com
TENANT_ROOT_DOMAIN=""
# Development only: pick which tenant's branding is used on logged-out pages
DEV_TENANT_SLUG="demo-clinic"

# --- Feature flags -----------------------------------------------------------
# Show not-yet-built modules as disabled "Soon" items in the sidebar (always on in development)
SHOW_PLANNED_MODULES="false"
# Expose /design-system in production (always available in development)
ENABLE_DESIGN_PREVIEW="false"

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error   (default: debug in development, info in production)
LOG_LEVEL=""

# --- Demo seed (development only; seed refuses to run when NODE_ENV=production) -
# Password for demo users. If empty, a random one is generated and printed once.
SEED_DEMO_PASSWORD=""

# --- Integrations (NOT configured in Phase 0 — placeholders only) -------------
# WHATSAPP_PROVIDER=""
# WHATSAPP_API_KEY=""
# SMS_PROVIDER=""
# SMS_API_KEY=""
# SMTP_URL=""
