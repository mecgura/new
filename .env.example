# ---- MECGURA WhatsApp — server configuration ----
PORT=8080
APP_URL=https://whatsapp.mecgura.tech
# Long random string (openssl rand -hex 32). Signs logins and encrypts stored tokens. Never change after launch.
APP_SECRET=
DATA_DIR=./data

# First-boot super admin (MECGURA owner account)
ADMIN_EMAIL=hello@mecgura.com
ADMIN_PASSWORD=
# Set to 1 once to load demo data (sandbox number, contacts, templates, flow) into the admin workspace
SEED_DEMO=0

# ---- Meta / WhatsApp Cloud API ----
WA_GRAPH_VERSION=v23.0
WA_VERIFY_TOKEN=choose-a-random-verify-token
# From your Meta app (needed for webhook signature checks and Embedded Signup)
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration ID (Meta app → Facebook Login for Business → Configurations)
META_EMBEDDED_CONFIG_ID=

# ---- AI assistant (Anthropic) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ---- Subscription billing (MECGURA's own Razorpay account) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
