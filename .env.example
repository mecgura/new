# ---- MECGURA WhatsApp — server configuration ----
PORT=8080
# Public site (Vercel) and the API server (VPS). The site proxies /api, /webhooks and /uploads to API_URL.
APP_URL=https://www.mecgura.tech
API_URL=https://api.mecgura.tech
# Proxy hops in front of Node: Vercel -> nginx -> node = 2
TRUST_PROXY=2
# Long random string (openssl rand -hex 32). Signs logins and encrypts stored tokens. Never change after launch.
APP_SECRET=
DATA_DIR=./data

# First-boot super admin (MECGURA owner account)
ADMIN_EMAIL=hello@mecgura.com
ADMIN_PASSWORD=
# Set to 1 once to load demo data (sandbox number, contacts, templates, flow) into the admin workspace
SEED_DEMO=0

# ---- Meta / WhatsApp Cloud API ----
WA_GRAPH_VERSION=v23.0
WA_VERIFY_TOKEN=choose-a-random-verify-token
# From your Meta app (needed for webhook signature checks and Embedded Signup)
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration ID (Meta app → Facebook Login for Business → Configurations)
META_EMBEDDED_CONFIG_ID=

# ---- MECGURA email: bills, receipts, welcome/invite emails, password resets ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MECGURA <hello@mecgura.com>

# ---- AI assistant (Anthropic) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Plans & billing are managed by MECGURA in the admin console. Set to `visible` to let clients see
# Plan & Billing and pay online themselves.
CLIENT_BILLING=hidden

# ---- Subscription billing (MECGURA's own Razorpay account) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks: URL https://api.mecgura.tech/webhooks/razorpay-billing, event payment_link.paid
RAZORPAY_WEBHOOK_SECRET=
