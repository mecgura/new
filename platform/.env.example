# Copy to .env and fill in. NEVER commit real values.

# --- Server-only secrets ---------------------------------------------------
# SQLite locally ("file:./dev.db"); PostgreSQL in production ("postgresql://...")
DATABASE_URL="file:./dev.db"
# Auth.js session signing key — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Production only: point Prisma at the PostgreSQL schema
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"
# Razorpay (website payments + subscription invoices). The key id is set in Admin → Settings → Razorpay.
RAZORPAY_KEY_SECRET=""
# Billing: secret for the Razorpay webhook (dashboard → Webhooks → URL /api/webhooks/payments/razorpay,
# events payment.captured + payment.failed). Without it invoices can't be paid online and stay unpaid
# until an admin records a payment — nothing is ever marked paid automatically.
RAZORPAY_WEBHOOK_SECRET=""
# Transactional email for password reset (Resend). Without these, reset emails
# are printed to the server log in development and DISABLED in production.
RESEND_API_KEY=""
EMAIL_FROM="Platform <no-reply@your-domain>"

# --- Seeding only (never needed at runtime) ---------------------------------
# First Super Admin (required for the seed)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional: creates two demo tenants (demo-org-a / demo-org-b) for QA
SEED_DEMO_PASSWORD=""

# --- Public (exposed to the browser) ----------------------------------------
# This app's own public URL: webhook callback URLs, password-reset links, canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional support contact shown in the Help menu (nothing is shown when empty)
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# --- WhatsApp / Meta (Phase 3) — server-only -----------------------------------
# MECGURA's Meta app (Embedded Signup). Leave empty to run in setup/demo state.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_WEBHOOK_VERIFY_TOKEN=""
# Graph API version (defaults to v23.0)
META_GRAPH_API_VERSION=""
# 32-byte base64 key for encrypting WhatsApp credentials (REQUIRED in production)
#   openssl rand -base64 32
WHATSAPP_ENCRYPTION_KEY=""
# Demo connections: "on" | "off" (default: on only while Meta isn't configured)
WHATSAPP_DEMO_MODE=""

# --- Campaigns (Phase 5) — server-only ---------------------------------------
# Secret for the campaign scheduler cron (GET /api/cron/campaigns with
# "Authorization: Bearer <CRON_SECRET>"). Needed on serverless hosts (Vercel);
# self-hosted `next start` runs an in-process scheduler instead.
CRON_SECRET=
# "off" disables the in-process scheduler on self-hosted servers
CAMPAIGN_SCHEDULER=

# --- Automations (Phase 6) — server-only ---------------------------------------
# Enables real AI (Claude): the "AI response" automation step and the live AI
# agent (/ai). Without it the automation step fails with a clear message, and the
# AI agent runs in a clearly-labelled rule-based DEMO mode on demo numbers only —
# live numbers get no automatic AI replies.
ANTHROPIC_API_KEY=
